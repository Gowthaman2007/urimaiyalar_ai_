# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# GEMINI_MODEL: Model alias to use for AI orchestration
GEMINI_MODEL="gemini-3.8-flash"

# DATABASE_URL: PostgreSQL connection string for production (e.g., postgresql://user:pass@host:5432/urimaiyalar)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urimaiyalar_ai"

# SESSION_SECRET: Secret key for signing JWT tokens and session cookies
SESSION_SECRET="urimaiyalar_secure_jwt_secret_key_2026"

# AI_NLU_PROVIDER: Provider to use ('gemini' or 'urimaiyalar')
AI_NLU_PROVIDER="gemini"

# URIMAIYALAR_NLU_URL: URL to standalone Urimaiyalar custom NLU FastAPI service
URIMAIYALAR_NLU_URL="http://localhost:8000"

# CORS_ORIGIN: Allowed origins for API requests
CORS_ORIGIN="*"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

